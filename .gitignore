# Rust build output (keep Cargo.lock tracked for this application).
/target/
/dist/
__pycache__/

# Local environment settings; example files may be committed.
.env
.env.*
!.env.example
!.env.*.example

# Logs and temporary files.
*.log
*.tmp
*.swp
*.swo
*~

# Local editor and operating-system files.
/.idea/
/.vscode/
.DS_Store
Thumbs.db

# Signing material belongs in the user's external GnuPG home, never this tree.
.gnupg/
private-keys-v1.d/
*.key
*.pem
*.p12
*.pfx
*.gpg
*.kbx
*.asc
